# Telegram Bot токен (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OpenWeather API ключ (получить на https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Настройки базы данных
DB_NAME=fitness.db/fitness.sqlite

# URL для API OpenFoodFacts
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/cgi/search.pl?action=process&search_terms

# Настройки логирования
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Настройки временной зоны
TZ=Europe/Moscow

# Настройки Docker
DOCKER_RESTART_POLICY=always
DOCKER_MEMORY_LIMIT=500M
DOCKER_CPU_LIMIT=0.5